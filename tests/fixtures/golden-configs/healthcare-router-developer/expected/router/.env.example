# Local-router environment template
# Active compliance frameworks: hipaa.
# Secret values stay in the gitignored .env — never commit them.

# Port the router listens on.
ROUTER_PORT=8787

# Ollama runtime — local-only by default.
OLLAMA_HOST=http://localhost:11434
OLLAMA_LOCAL_MODEL=qwen2.5-coder:32b

# Anthropic — required when escalation is enabled and the request
# selects the anthropic backend. Provision a key with the minimum
# capability and rotate quarterly.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Routing audit log. JSONL, append-only. Rotate via logrotate.
ROUTER_AUDIT_LOG_PATH=./router-audit.jsonl

# Per-deployment HMAC key for hashing prompts in the audit log.
# Generate with: openssl rand -hex 32
ROUTER_AUDIT_HASH_KEY=

# Classifier thresholds — tune per workload.
ROUTER_MAX_LOCAL_TOKENS=512

# Confidence-escalation threshold (0..1). Local answers scoring
# below this get redacted (if HIPAA) and re-dispatched to a hosted LLM.
ROUTER_CONFIDENCE_THRESHOLD=0.55
