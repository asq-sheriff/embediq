  "mcpServers": {
    "ollama-sidekick": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic/ollama-claude"
      ],
      "env": {
        "OLLAMA_HOST": "http://localhost:11434"
      }
    }
  }
}
